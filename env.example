# Copy values into your process environment or Render environment settings.
# This application does not automatically load .env files.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
# Set to actual time you last sent an inbound WhatsApp message, e.g. ISO UTC.
# Blank means paused; never invent a fresh timestamp without sending a message.
WHATSAPP_LAST_INBOUND_UTC=
DRY_RUN=true
MIN_MARGIN_GBP=20
SCAN_INTERVAL_SECONDS=900
MAX_PAGES_PER_RULE=1
WATCHLIST_PATH=watchlist.json
DATABASE_PATH=data/alerts.sqlite3
